{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ServerVersion": "8.4.0",
    "AplicarScriptsAoIniciar": false
  },
  "Jwt": {
    "Emissor": "rh-system",
    "Audiencia": "rh-system-web",
    "AcessoMinutos": 15,
    "RefreshDias": 7
  },
