<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RHSystem.Application\RHSystem.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os scripts do banco (de "Banco de Dados/Scripts") viajam dentro do assembly. O nome lógico é o que o ScriptsEmbutidos lê. -->
