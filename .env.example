# Valores de desenvolvimento local. Copie este arquivo para .env (o git ignora o .env).
# Nunca use estes valores fora da sua máquina e nunca ponha segredo de verdade aqui.
MYSQL_ROOT_PASSWORD=rh_dev_root
MYSQL_DATABASE=rh_system
# Se já houver um MySQL na porta 3306, troque esta porta (por exemplo, 3307).
MYSQL_PORTA=3306
# Mailpit (e-mails de desenvolvimento): SMTP na 1025 e a interface em http://localhost:8025. Troque as portas se já houver algo nelas.
MAILPIT_SMTP_PORTA=1025
MAILPIT_UI_PORTA=8025
# Azurite (arquivos de desenvolvimento, Blob Storage): a porta do blob. Troque se já houver algo na 10000.
# O Development da API usa UseDevelopmentStorage=true (127.0.0.1:10000): se trocar a porta, ponha a connection string do Azurite com a nova porta nos user-secrets.
AZURITE_BLOB_PORTA=10000
